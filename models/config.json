{
  "num_codebooks": 16,

  "vocab_size": {
    "text": 256,
    "audio": 2049
  },

  "limits": {
    "text_seq_len": 256,
    "audio_seq_len": 512
  },

  "special_tokens": {
    "text_pad": 0,
    "audio_pad": 2048,
    "bos": 256,
    "ref_text_eos": 257,
    "ref_codec_eos": 258,
    "text_eos": 259,
    "eos": 2049
  },

  "embedding_dim": 512,
  "intermediate_dim": 512,

  "codec_embedding": {
    "token_embedding_dim": 128,
    "mlp_hidden_dim": 1024,
    "mlp_num_layers": 2,
    "mlp_dropout": 0.1
  },

  "decoder": {
    "no_layers": 12,
    "no_heads": 8,
    "hidden_dim": 512,
    "ffn_dim": 2048,
    "ffn_glu": false,
    "dropout": 0.2
  },

  "codebook_projector": {
    "no_context_chunks": 4,
    "d_model": 256,
    "num_layers": 2,
    "num_heads": 4,
    "ffn_dim": 512,
    "dropout": 0.3
  },

  "init_std": 0.02,

  "training": {
    "learning_rate": 3e-4,
    "batch_size": 8,
    "num_epochs": 50,
    "warmup_fraction": 0.02,
    "weight_decay": 0.05,
    "grad_clip": 1.0,
    "weighted_loss": true,
    "loss_decay": 0.9,
    "log_interval": 50,
    "save_interval": 2,
    "val_fraction": 0.1,
    "phonemes_csv": "data/norbi/phonemes.csv",
    "codec_dir": "data/norbi/codecs",
    "output_dir": "models"
  }
}