{
  "latent_dim": 24,

  "vocab_size": {
    "text": 256
  },

  "limits": {
    "text_seq_len": 256,
    "audio_seq_len": 512
  },

  "special_tokens": {
    "text_pad": 0,
    "bos": 256,
    "ref_text_eos": 257,
    "ref_audio_eos": 258,
    "text_eos": 259
  },

  "embedding_dim": 512,
  "intermediate_dim": 512,

  "decoder": {
    "no_layers": 12,
    "no_heads": 8,
    "hidden_dim": 512,
    "ffn_dim": 2048,
    "ffn_glu": false,
    "dropout": 0.2
  },

  "init_std": 0.02,

  "training": {
    "learning_rate": 5e-4,
    "batch_size": 16,
    "num_epochs": 40,
    "warmup_fraction": 0.01,
    "weight_decay": 0.05,
    "grad_clip": 1.0,
    "log_interval": 50,
    "save_interval": 5,
    "val_fraction": 0.1,
    "phonemes_csv": "data/norbi/phonemes.csv",
    "latent_dir": "data/norbi/latents",
    "output_dir": "models"
  }
}