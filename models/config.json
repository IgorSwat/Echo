{
  "latent_dim": 24,

  "vocab_size": {
    "text": 256
  },

  "special_tokens": {
    "text_pad": 0
  },

  "text_embedding_dim": 256,
  "time_embedding_dim": 128,

  "init_std": 0.02,

  "text_encoder": {
    "num_layers": 6,
    "num_heads": 8,
    "ffn_dim": 1024,
    "ffn_glu": false,
    "kernel_size": 5,
    "dropout": 0.1,
    "use_rope": true,
    "conv_use_norm": true
  },

  "blocks": [
    {"type": "convnext", "dim_in": 24, "dim_out": 64, "kernel_size": 7, "dropout": 0.1},
    {"type": "convnext", "dim_in": 64, "dim_out": 64, "kernel_size": 7, "dropout": 0.1},
    {"type": "convnext", "dim_in": 64, "dim_out": 128, "kernel_size": 7, "dropout": 0.1},
    {"type": "self_attention", "d_model": 128, "num_heads": 4, "ffn_dim": 512, "dropout": 0.1, "use_rope": true},
    {"type": "convnext", "dim_in": 128, "dim_out": 128, "kernel_size": 7, "dropout": 0.1},
    {"type": "convnext", "dim_in": 128, "dim_out": 256, "kernel_size": 7, "dropout": 0.1},
    {"type": "convnext", "dim_in": 256, "dim_out": 256, "kernel_size": 7, "dropout": 0.1},
    {"type": "self_attention", "d_model": 256, "num_heads": 4, "ffn_dim": 1024, "dropout": 0.1, "use_rope": true},
    {"type": "cross_attention", "d_query": 256, "d_kv": 256, "d_model": 256, "num_heads": 8, "ffn_dim": 1024, "dropout": 0.1, "use_rope": true, "use_ada_ln": true},
    {"type": "convnext", "dim_in": 256, "dim_out": 256, "kernel_size": 7, "dropout": 0.1},
    {"type": "convnext", "dim_in": 256, "dim_out": 512, "kernel_size": 7, "dropout": 0.1},
    {"type": "self_attention", "d_model": 512, "num_heads": 8, "ffn_dim": 2048, "dropout": 0.1, "use_rope": true},
    {"type": "cross_attention", "d_query": 512, "d_kv": 256, "d_model": 512, "num_heads": 8, "ffn_dim": 2048, "dropout": 0.1, "use_rope": true, "use_ada_ln": true},
    {"type": "self_attention", "d_model": 512, "num_heads": 8, "ffn_dim": 2048, "dropout": 0.1, "use_rope": true},
    {"type": "cross_attention", "d_query": 512, "d_kv": 256, "d_model": 512, "num_heads": 8, "ffn_dim": 2048, "dropout": 0.1, "use_rope": true, "use_ada_ln": true},
    {"type": "self_attention", "d_model": 512, "num_heads": 8, "ffn_dim": 2048, "dropout": 0.1, "use_rope": true},
    {"type": "cross_attention", "d_query": 512, "d_kv": 256, "d_model": 512, "num_heads": 8, "ffn_dim": 2048, "dropout": 0.1, "use_rope": true, "use_ada_ln": true},
    {"type": "self_attention", "d_model": 512, "num_heads": 8, "ffn_dim": 2048, "dropout": 0.1, "use_rope": true},
    {"type": "cross_attention", "d_query": 512, "d_kv": 256, "d_model": 512, "num_heads": 8, "ffn_dim": 2048, "dropout": 0.1, "use_rope": true, "use_ada_ln": true},
    {"type": "self_attention", "d_model": 512, "num_heads": 8, "ffn_dim": 2048, "dropout": 0.1, "use_rope": true}
  ],

  "training": {
    "data_dir": "data/norbi",
    "output_dir": "checkpoints",
    "batch_size": 16,
    "num_epochs": 30,
    "val_ratio": 0.05,
    "learning_rate": 3e-4,
    "weight_decay": 0.01,
    "warmup_steps": 500,
    "grad_clip": 1.0,
    "num_workers": 4,
    "log_every": 20,
    "save_every": 2000,
    "seed": 42,
    "text_dropout": 0.2
  }
}
